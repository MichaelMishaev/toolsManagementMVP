               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Fast mowing  |  Smart remote control  |  Flexible mobility</photoshop:LayerName>
                  <photoshop:LayerText>Fast mowing  |  Smart remote control  |  Flexible mobility</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>New crawler remote control mower, super operation, powerful fun</photoshop:LayerName>
                  <photoshop:LayerText>New crawler remote control mower, super operation, powerful function</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>HS800  lawn mower</photoshop:LayerName>
                  <photoshop:LayerText>HS800  lawn mower</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Product  introduction</photoshop:LayerName>
                  <photoshop:LayerText>Product  introduction</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Remote control operation man-machine separation, safer and easi</photoshop:LayerName>
                  <photoshop:LayerText>Remote control operation man-machine separation, safer and easier operation, labor liberation</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>The remote control Lawn Mower can complete the work of mowing t</photoshop:LayerName>
                  <photoshop:LayerText>The remote control Lawn Mower can complete the work of mowing the lawn independently,  without direct human control and operation, and has low power, low noise, exquisite and beautiful appearance,  and greatly reduces manual operation. The remote control Lawn Mower is suitable for clearing all kinds of weeds such as reeds, alfalfa,  fish grass and other large and small plots of plains, hills, terraces, orchards, and triangles,  with simple operation and high work efficiency. We usually use lawn mowers for school and street beautification. In  foreign countries, many families have lawn mowers for weeding their gardens.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>HS800  lawn mower</photoshop:LayerName>
                  <photoshop:LayerText>HS800  lawn mower</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Product parameter</photoshop:LayerName>
                  <photoshop:LayerText>Product parameter</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Remote control operation man-machine separation, safer and easi</photoshop:LayerName>
                  <photoshop:LayerText>Remote control operation man-machine separation, safer and easier operation, labor liberation</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Product Model Overall Dimensions Packaging Dimensions Cutting W</photoshop:LayerName>
                  <photoshop:LayerText>Product Model Overall Dimensions Packaging Dimensions Cutting Width Cutting Height Travel Speed Gradeability Cutterhead Adjustment Engine Power Fuel Tank Capacity Oil Capacity Mowing Efficiency: Voltage &amp; Battery Capacity</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>HS800   1100*1270*650 mm   1150*1320*820 mm   800 mm   20-150 m</photoshop:LayerName>
                  <photoshop:LayerText>HS800   1100*1270*650 mm   1150*1320*820 mm   800 mm   20-150 mm   5 km/h   45Â°   Remote-controlled lifting  Loncin 452 / Loncin 608   16HP / 23HP   7.1L   1.2L   3800mÂ²/h   24V / 40AH  </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>HS800  lawn mower</photoshop:LayerName>
                  <photoshop:LayerText>HS800  lawn mower</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
